  .empty-state {
    color: var(--muted);
    font-family: var(--mono);
    font-size: 10px;
    text-align: center;
    padding: 12px 0;
    letter-spacing: 0.05em;
  }
 
  /* ── Footer ── */
  .footer {
    font-family: var(--mono);
    font-size: 10px;
    color: var(--muted);
    border-top: 1px solid var(--border);
    padding-top: 8px;
    letter-spacing: 0.05em;
    display: flex;
    gap: 16px;
    flex-wrap: wrap;
  }
  .footer span { color: var(--amber-dim); }
 
  @media (max-width: 640px) {
    .scores-grid { grid-template-columns: 1fr; }
    .score-block { border-right: none; border-bottom: 1px solid var(--border); padding-right: 0; padding-bottom: 12px; }
    .score-block:last-child { border-bottom: none; padding-bottom: 0; }
    .zip-grid { grid-template-columns: 1fr; }
    .field-row { grid-template-columns: 1fr 70px 70px 40px 20px; }
    .row-headers { grid-template-columns: 1fr 70px 70px 40px 20px; }
  }
</style>
</head>
<body>
<div class="shell">
 
  <!-- Header -->
  <div class="header">
    <h1>RVEIRS</h1>
    <span>eddy calculator</span>
    <div class="presets">
      <button class="preset-btn" onclick="loadPreset('main')">▶ Main St. Diner</button>
      <button class="preset-btn" onclick="loadPreset('mamas')">▶ Mama's Diner</button>
      <button class="preset-btn" onclick="loadPreset('riorojo')">▶ Rio Rojo</button>
      <button class="preset-btn" onclick="clearAll()">✕ clear</button>
      <button class="preset-btn" id="theme-btn" onclick="toggleTheme()" style="margin-left:8px">☀ light</button>
    </div>
  </div>
 
  <!-- Scores -->
  <div class="scores-panel">
    <div class="scores-top-row">
      <span class="card-label">Scores</span>
      <label class="math-toggle" onclick="toggleMathMode()">
        <span class="math-toggle-label">math mode</span>
        <div class="toggle-track" id="math-track"><div class="toggle-thumb"></div></div>
      </label>
    </div>
 
    <div class="scores-grid">
 
      <!-- eddy_1: node location -->
      <div class="score-block">
        <div class="score-name">eddy_1 &nbsp;·&nbsp; entity location</div>
        <div id="e1-tag" class="node-zone-tag zone-void">—</div>
        <div class="score-label" id="e1-label">set home zip + zone config</div>
        <div class="math-array" id="e1-array">
          <div class="math-row"><span class="mkey">local</span><span class="mval local" id="e1-local">—</span></div>
          <div class="math-row"><span class="mkey">close</span><span class="mval close" id="e1-close">—</span></div>
          <div class="math-row"><span class="mkey">far  </span><span class="mval far"   id="e1-far">—</span></div>
          <div class="math-row"><span class="mkey">void </span><span class="mval void"  id="e1-void">—</span></div>
          <div class="math-row" style="margin-top:2px;padding-top:4px;border-top:1px solid var(--border)">
            <span class="mkey">depth[0]</span><span class="mval depth">1.000</span>
          </div>
        </div>
      </div>
 
      <!-- Share score -->
      <div class="score-block">
        <div class="score-name">depth_2 &nbsp;·&nbsp; outflow coverage</div>
        <div class="score-value" id="ss-val">—</div>
        <div class="score-bar-track"><div class="score-bar-fill" id="ss-bar" style="width:0%"></div></div>
        <div class="score-label" id="ss-label">fraction of outflows with known destination</div>
        <div class="math-array" id="ss-array">
          <div class="math-row"><span class="mkey">depth[0]</span><span class="mval depth">1.000</span></div>
          <div class="math-row"><span class="mkey">depth[1]</span><span class="mval depth" id="depth1-val">—</span></div>
          <div class="math-row"><span class="mkey">depth[2]</span><span class="mval dim">network required</span></div>
        </div>
      </div>
 
      <!-- eddy_2: local circulation -->
      <div class="score-block">
        <div class="score-name">eddy_2 &nbsp;·&nbsp; local circulation</div>
        <div class="score-value" id="e2-val">—</div>
        <div class="score-bar-track"><div class="score-bar-fill" id="e2-bar" style="width:0%"></div></div>
        <div class="score-label" id="e2-label">local + (close × 0.5)</div>
        <div class="math-array" id="e2-array">
          <div class="math-row"><span class="mkey">local</span><span class="mval local" id="e2-local">—</span></div>
          <div class="math-row"><span class="mkey">close</span><span class="mval close" id="e2-close">—</span></div>
          <div class="math-row"><span class="mkey">far  </span><span class="mval far"   id="e2-far">—</span></div>
          <div class="math-row"><span class="mkey">void </span><span class="mval void"  id="e2-void">—</span></div>
          <div class="math-row" style="margin-top:2px;padding-top:4px;border-top:1px solid var(--border)">
            <span class="mkey">depth[1]</span><span class="mval depth" id="e2-depth">—</span>
          </div>
        </div>
      </div>
 
    </div>
  </div>
 
  <!-- Zone vector bar -->
  <div class="vector-panel">
    <div class="vector-bar">
      <div class="vbar-seg vbar-local" id="vb-local" style="width:0%"></div>
      <div class="vbar-seg vbar-close" id="vb-close" style="width:0%"></div>
      <div class="vbar-seg vbar-far"   id="vb-far"   style="width:0%"></div>
      <div class="vbar-seg vbar-void"  id="vb-void"  style="width:100%">no data</div>
    </div>
    <div class="vector-legend">
      <div class="legend-item legend-local">
        <span class="legend-zone">local</span>
        <span class="legend-pct" id="l-local-pct">—</span>
        <span class="legend-amt" id="l-local-amt"></span>
      </div>
      <div class="legend-item legend-close">
        <span class="legend-zone">close</span>
        <span class="legend-pct" id="l-close-pct">—</span>
        <span class="legend-amt" id="l-close-amt"></span>
      </div>
      <div class="legend-item legend-far">
        <span class="legend-zone">far</span>
        <span class="legend-pct" id="l-far-pct">—</span>
        <span class="legend-amt" id="l-far-amt"></span>
      </div>
      <div class="legend-item legend-void">
        <span class="legend-zone">void</span>
        <span class="legend-pct" id="l-void-pct">—</span>
        <span class="legend-amt" id="l-void-amt"></span>
      </div>
    </div>
    <div class="total-line">
      <span>total throughput (inflows)</span>
      <span id="l-total">—</span>
    </div>
  </div>
 
  <!-- Export / network payload -->
  <div class="export-panel">
    <div class="export-header">
      <span class="card-label">Network Payload</span>
      <button class="export-btn" id="export-toggle-btn" onclick="toggleExport()">▶ show payload</button>
    </div>
    <div class="export-box" id="export-box"></div>
    <div class="export-note" id="export-note">This is what your node would share with the network — ratios and zip codes only. No dollar amounts leave your device.</div>
  </div>
 
  <!-- Tabs -->
  <div>
    <div class="tab-bar">
      <button class="tab-btn active" onclick="switchTab('outflows')">Outflows</button>
      <button class="tab-btn"        onclick="switchTab('inflows')">Inflows</button>
      <button class="tab-btn"        onclick="switchTab('settings')">Zone Settings</button>
    </div>
 
    <!-- Outflows -->
    <div class="tab-pane active card" id="tab-outflows">
      <div class="flow-label">
        <span class="flow-dir">→ OUT</span>
        <span>where your money goes — suppliers, rent, utilities, wages</span>
      </div>
      <div class="row-headers">
        <span>Counterparty</span><span>Amount $</span><span>Dest. zip</span><span>Zone</span><span></span>
      </div>
      <div id="out-rows-container"></div>
      <button class="add-btn" onclick="addOutRow()">+ add row</button>
    </div>
 
    <!-- Inflows -->
    <div class="tab-pane card" id="tab-inflows">
      <div class="flow-label">
        <span class="flow-dir">← IN</span>
        <span>where your money comes from — total monthly throughput</span>
      </div>
      <div class="inflow-headers">
        <span>Source</span><span>Amount $</span><span></span>
      </div>
      <div id="in-rows-container"></div>
      <button class="add-btn" onclick="addInRow()">+ add row</button>
    </div>
 
    <!-- Settings -->
    <div class="tab-pane card" id="tab-settings">
      <div class="field" style="margin-bottom:14px">
        <label>Business name (optional)</label>
        <input type="text" id="biz-name" placeholder="e.g. Mama's Diner" oninput="recalc()">
      </div>
      <div class="field" style="margin-bottom:14px">
        <label>Home zip</label>
        <input type="text" id="home-zip" placeholder="72901" oninput="updateZoneDefaults(); recalc()" style="max-width:160px">
      </div>
      <div class="zip-grid">
        <div>
          <div class="zip-col-label"><span class="zone-dot dot-local"></span>Local zips</div>
          <div class="zip-list" id="local-list"></div>
          <button class="zip-add-btn" onclick="addZip('local')">+ add local zip</button>
        </div>
        <div>
          <div class="zip-col-label"><span class="zone-dot dot-close"></span>Close zips</div>
          <div class="zip-list" id="close-list"></div>
          <button class="zip-add-btn" onclick="addZip('close')">+ add close zip</button>
        </div>
      </div>
      <div class="far-void-note">
        <strong>Far</strong> = any other known zip &nbsp;·&nbsp; <strong>Void</strong> = blank or 99999
      </div>
      <div style="margin-top:14px;padding-top:12px;border-top:1px solid var(--border)">
        <div class="card-label" style="margin-bottom:8px">Zone presets</div>
        <div style="display:flex;gap:6px;flex-wrap:wrap">
          <button class="preset-btn" onclick="applyZonePreset('fortsmith')">Fort Smith / River Valley</button>
          <button class="preset-btn" onclick="applyZonePreset('eureka')">Carroll County / Eureka Springs</button>
        </div>
      </div>
    </div>
  </div>
 
  <!-- Footer -->
  <div class="footer">
    <div><span>eddy_1</span> = entity location zone vector &nbsp;·&nbsp; depth_1 always 1.000</div>
    <div><span>depth_2</span> = known outflows ÷ throughput &nbsp;·&nbsp; 1 − void fraction</div>
    <div><span>eddy_2</span> = local_ratio + (close_ratio × 0.5) &nbsp;·&nbsp; as fraction of throughput</div>
    <div><span>eddy_3+</span> = recursive network score &nbsp;·&nbsp; requires network data</div>
  </div>
 
</div>
<script>
// ── State ──────────────────────────────────────────────────────────────────
let outRowCount = 0;
let inRowCount  = 0;
let mathMode    = false;
let exportOpen  = false;
let localZipList = [];
let closeZipList = [];
 
// ── Presets ────────────────────────────────────────────────────────────────
const PRESETS = {
  main: {
    name: 'Main Street Diner', homeZip: '72901',
    localZips: ['72901'], closeZips: ['72903','72904','72956'],
    inRows: [{ name:'Monthly revenue', amount:12000 }],
    outRows: [
      { name:'Employee wages',         amount:4000, zip:'72901' },
      { name:'Commercial rent',        amount:1500, zip:'72901' },
      { name:'Local produce supplier', amount:800,  zip:'72903' },
      { name:'Sysco (national)',        amount:1200, zip:'30328' },
      { name:'Entergy Arkansas',        amount:400,  zip:'72201' },
      { name:'Unknown misc',            amount:300,  zip:''      },
    ]
  },
  mamas: {
    name:"Mama's Diner", homeZip:'72901',
    localZips:['72901','72903','72904','72921','72936','72941','72956'],
    closeZips:['72201'],
    inRows:[ { name:'Monthly revenue', amount:28000 } ],
    outRows:[
      { name:"Linda's salary",           amount:3500, zip:'72901' },
      { name:'Cook (full time)',          amount:2200, zip:'72904' },
      { name:'Waitstaff x2',             amount:2800, zip:'72901' },
      { name:'Dishwasher (part time)',    amount:900,  zip:'72901' },
      { name:'Rent — Willow Creek LLC',   amount:3200, zip:'75201' },
      { name:'Sysco Food Services',       amount:7400, zip:'77077' },
      { name:'Payroll taxes (IRS)',        amount:1100, zip:'20224' },
      { name:'Arkansas sales tax',        amount:800,  zip:'72201' },
      { name:'Entergy Arkansas',          amount:620,  zip:'72201' },
      { name:'Chase bank fees',           amount:180,  zip:'10017' },
      { name:'Uniforms/supplies (Amazon)',amount:340,  zip:'98109' },
      { name:'Unknown/misc',              amount:960,  zip:''      },
    ]
  },
  riorojo: {
    name:'Rio Rojo Fort Smith', homeZip:'72901',
    localZips:['72901','72903','72904','72921','72936','72941','72956'],
    closeZips:['72201','72712'],
    inRows:[ { name:'Monthly revenue', amount:32000 } ],
    outRows:[
      { name:'Carlos salary',            amount:4200, zip:'72903' },
      { name:'Line cook x2',             amount:4400, zip:'72901' },
      { name:'Front of house x3',        amount:3900, zip:'72904' },
      { name:'Busser/prep (part time)',   amount:1100, zip:'72901' },
      { name:'Rent — Garrison Ave Props', amount:2800, zip:'72901' },
      { name:'Rivera Family Farm',        amount:2200, zip:'72936' },
      { name:'Alma Rice Co-op',           amount:800,  zip:'72921' },
      { name:'Tortilleria Lupita',        amount:1100, zip:'72956' },
      { name:'Arvest Bank',               amount:140,  zip:'72901' },
      { name:'Entergy Arkansas',          amount:580,  zip:'72201' },
      { name:'Arkansas sales tax',        amount:900,  zip:'72201' },
      { name:'Cielito Lindo mgmt fee',    amount:2400, zip:'75201' },
      { name:'Restaurant Depot',          amount:1800, zip:'72712' },
      { name:'Payroll taxes (IRS)',        amount:1300, zip:'20224' },
      { name:'Unknown/misc',              amount:380,  zip:''      },
    ]
  }
};
 
const ZONE_PRESETS = {
  fortsmith: {
    local:['72901','72902','72903','72904','72905','72906','72908','72916','72921','72936','72941','72956'],
    close:['72201','72202','72203','72204','72205','72206','72207','72209','72210','72211','72212','72214','72215','72217','72219','72221']
  },
  eureka: {
    local:['72632','72661','72616','72631','72611'],
    close:['72653','72756','72745','72752','72717']
  }
};
 
function loadPreset(key) {
  const p = PRESETS[key];
  document.getElementById('biz-name').value = p.name;
  document.getElementById('home-zip').value = p.homeZip;
  localZipList = [...p.localZips];
  closeZipList = [...p.closeZips];
  renderZipLists();
 
  document.getElementById('out-rows-container').innerHTML = '';
  document.getElementById('in-rows-container').innerHTML  = '';
  outRowCount = 0; inRowCount = 0;
 
  p.outRows.forEach(r => addOutRow(r.name, r.amount, r.zip));
  p.inRows.forEach(r  => addInRow(r.name, r.amount));
  recalc();
}
 
function clearAll() {
  document.getElementById('biz-name').value = '';
  document.getElementById('home-zip').value = '';
  localZipList = []; closeZipList = [];
  renderZipLists();
  document.getElementById('out-rows-container').innerHTML = '';
  document.getElementById('in-rows-container').innerHTML  = '';
  outRowCount = 0; inRowCount = 0;
  addOutRow(); addOutRow(); addOutRow();
  addInRow();
  recalc();
}
 
function applyZonePreset(key) {
  const p = ZONE_PRESETS[key];
  localZipList = [...p.local];
  closeZipList = [...p.close];
  renderZipLists();
  recalc();
}
 
// ── Zip list management ────────────────────────────────────────────────────
function addZip(type) {
  if (type === 'local') localZipList.push('');
  else                  closeZipList.push('');
  renderZipLists();
  const list = document.getElementById(type+'-list');
  const inputs = list.querySelectorAll('input');
  if (inputs.length) inputs[inputs.length-1].focus();
}
function removeZip(type, idx) {
  if (type === 'local') localZipList.splice(idx,1);
  else                  closeZipList.splice(idx,1);
  renderZipLists(); recalc();
}
function updateZip(type, idx, val) {
  if (type === 'local') localZipList[idx] = val.trim();
  else                  closeZipList[idx] = val.trim();
  recalc();
}
function renderZipLists() {
  ['local','close'].forEach(type => {
    const arr = type === 'local' ? localZipList : closeZipList;
    const el  = document.getElementById(type+'-list');
    el.innerHTML = '';
    if (!arr.length) {
      el.innerHTML = '<div class="empty-state">no zips set</div>';
      return;
    }
    arr.forEach((zip,idx) => {
      const div = document.createElement('div');
      div.className = 'zip-entry';
      div.innerHTML = `<input type="text" value="${escHtml(zip)}" placeholder="e.g. 72901"
        oninput="updateZip('${type}',${idx},this.value)" style="font-size:12px;padding:3px 6px">
        <button class="zip-chip" onclick="removeZip('${type}',${idx})">×</button>`;
      el.appendChild(div);
    });
  });
}
function getLocalZips() { return new Set(localZipList.filter(Boolean)); }
function getCloseZips() { return new Set(closeZipList.filter(Boolean)); }
function updateZoneDefaults() {
  const hz = document.getElementById('home-zip').value.trim();
  if (hz && !localZipList.length) { localZipList = [hz]; renderZipLists(); }
}
 
// ── Tab switching ──────────────────────────────────────────────────────────
function switchTab(name) {
  const names = ['outflows','inflows','settings'];
  document.querySelectorAll('.tab-btn').forEach((b,i) => b.classList.toggle('active', names[i]===name));
  document.querySelectorAll('.tab-pane').forEach(p => p.classList.remove('active'));
  document.getElementById('tab-'+name).classList.add('active');
}
 
// ── Math mode ──────────────────────────────────────────────────────────────
function toggleMathMode() {
  mathMode = !mathMode;
  document.getElementById('math-track').classList.toggle('on', mathMode);
  document.querySelectorAll('.math-array').forEach(el => el.classList.toggle('visible', mathMode));
}
 
// ── Export ─────────────────────────────────────────────────────────────────
function toggleExport() {
  exportOpen = !exportOpen;
  document.getElementById('export-box').classList.toggle('visible', exportOpen);
  document.getElementById('export-note').classList.toggle('visible', exportOpen);
  document.getElementById('export-toggle-btn').textContent = exportOpen ? '▼ hide payload' : '▶ show payload';
  if (exportOpen) buildExport();
}
function buildExport() {
  const localZips = getLocalZips();
  const closeZips = getCloseZips();
  let totals = {local:0,close:0,far:0,void:0}, total = 0;
  document.querySelectorAll('[id^="out-r"][id$="-amount"]').forEach(el => {
    const m = el.id.match(/^out-r(\d+)-amount$/); if (!m) return;
    const amt = parseFloat(el.value)||0;
    const zipEl = document.getElementById(`out-r${m[1]}-zip`);
    const zone  = classifyZip(zipEl?zipEl.value:'', localZips, closeZips);
    if (amt>0) { totals[zone]+=amt; total+=amt; }
  });
  const ratios = total>0 ? {
    local:+(totals.local/total).toFixed(4),
    close:+(totals.close/total).toFixed(4),
    far:  +(totals.far  /total).toFixed(4),
    void: +(totals.void /total).toFixed(4),
  } : {local:0,close:0,far:0,void:1};
  const shareScore = +(ratios.local+ratios.close+ratios.far).toFixed(4);
  const e2 = +(ratios.local+ratios.close*0.5).toFixed(4);
  const homeZip  = document.getElementById('home-zip').value.trim();
  const nodeZone = classifyZip(homeZip, localZips, closeZips);
  const payload  = {
    node: {
      name: document.getElementById('biz-name').value||'unnamed',
      home_zip: homeZip,
      zone: nodeZone
    },
    eddy_1: { [nodeZone]: 1, depth: 1.000 },
    share_score: shareScore,
    eddy_2: { zone_vector: ratios, score: e2 },
    depth: { 0: 1.000, 1: shareScore, '2+': 'network required' },
    zone_config: { local:[...localZips], close:[...closeZips] },
    generated: new Date().toISOString().slice(0,10)
  };
  document.getElementById('export-box').textContent = JSON.stringify(payload, null, 2);
}
 
// ── Row management ─────────────────────────────────────────────────────────
function addOutRow(name='', amount='', zip='') {
  ++outRowCount;
  const id  = outRowCount;
  const div = document.createElement('div');
  div.className = 'field-row';
  div.id = `out-row-${id}`;
  div.innerHTML = `
    <input type="text"   id="out-r${id}-name"   placeholder="counterparty" value="${escHtml(name)}"   oninput="recalc()">
    <input type="number" id="out-r${id}-amount" placeholder="0.00"          value="${amount||''}"    oninput="recalc()" min="0" step="0.01">
    <input type="text"   id="out-r${id}-zip"    placeholder="zip"           value="${escHtml(zip)}"   oninput="recalc();updateOutTag(${id})">
    <div   id="out-r${id}-tag" class="zone-tag zone-blank">—</div>
    <button class="del-btn" onclick="removeOutRow(${id})">×</button>`;
  document.getElementById('out-rows-container').appendChild(div);
  updateOutTag(id);
}
function removeOutRow(id) {
  const el = document.getElementById(`out-row-${id}`); if (el) el.remove(); recalc();
}
function updateOutTag(id) {
  const zipEl = document.getElementById(`out-r${id}-zip`);
  const tagEl = document.getElementById(`out-r${id}-tag`);
  if (!zipEl||!tagEl) return;
  const zone = classifyZip(zipEl.value, getLocalZips(), getCloseZips());
  tagEl.className = `zone-tag zone-${zone}`;
  tagEl.textContent = {local:'LOCAL',close:'CLOSE',far:'FAR',void:'VOID'}[zone];
}
 
function addInRow(name='', amount='') {
  ++inRowCount;
  const id  = inRowCount;
  const div = document.createElement('div');
  div.className = 'inflow-row';
  div.id = `in-row-${id}`;
  div.innerHTML = `
    <input type="text"   id="in-r${id}-name"   placeholder="source" value="${escHtml(name)}"   oninput="recalc()">
    <input type="number" id="in-r${id}-amount" placeholder="0.00"   value="${amount||''}"    oninput="recalc()" min="0" step="0.01">
    <button class="del-btn" onclick="removeInRow(${id})">×</button>`;
  document.getElementById('in-rows-container').appendChild(div);
}
function removeInRow(id) {
  const el = document.getElementById(`in-row-${id}`); if (el) el.remove(); recalc();
}
 
// ── Zone logic ─────────────────────────────────────────────────────────────
function classifyZip(zip, localZips, closeZips) {
  const z = (zip||'').trim();
  if (!z || z==='99999') return 'void';
  if (localZips.has(z))  return 'local';
  if (closeZips.has(z))  return 'close';
  return 'far';
}
 
// ── Calculation ────────────────────────────────────────────────────────────
function recalc() {
  // update all out zone tags
  document.querySelectorAll('[id^="out-r"][id$="-zip"]').forEach(el => {
    const m = el.id.match(/^out-r(\d+)-zip$/); if (m) updateOutTag(parseInt(m[1]));
  });
 
  const localZips = getLocalZips();
  const closeZips = getCloseZips();
  const fmt$ = v => '$'+v.toLocaleString('en-US',{minimumFractionDigits:0,maximumFractionDigits:0});
 
  // eddy_1: node location — derived from home zip, not from flow data
  const homeZip  = document.getElementById('home-zip').value.trim();
  const nodeZone = classifyZip(homeZip, localZips, closeZips);
  const tag = document.getElementById('e1-tag');
  tag.className = `node-zone-tag zone-${nodeZone}`;
  tag.textContent = homeZip ? {local:'LOCAL',close:'CLOSE',far:'FAR',void:'VOID'}[nodeZone] : '—';
  document.getElementById('e1-label').textContent = homeZip
    ? `this node is in the ${nodeZone} zone`
    : 'set home zip + zone config';
  // math array for e1
  ['local','close','far','void'].forEach(z => {
    document.getElementById(`e1-${z}`).textContent = (z === nodeZone && homeZip) ? '1.000' : '0.000';
  });
 
  // inflows — throughput is the denominator for all ratios
  let throughput = 0;
  document.getElementById('in-rows-container').querySelectorAll('input[type="number"]').forEach(el => {
    throughput += parseFloat(el.value) || 0;
  });
 
  // outflows — sum by zone
  let totals = {local:0, close:0, far:0, void:0};
  let totalOut = 0;
  document.getElementById('out-rows-container').querySelectorAll('.field-row').forEach(row => {
    const numInputs  = row.querySelectorAll('input[type="number"]');
    const textInputs = row.querySelectorAll('input[type="text"]');
    const amt  = parseFloat(numInputs[0] ? numInputs[0].value : 0) || 0;
    const zip  = textInputs[1] ? textInputs[1].value : ''; // second text = zip
    const zone = classifyZip(zip, localZips, closeZips);
    if (amt > 0) { totals[zone] += amt; totalOut += amt; }
  });
 
  // denominator: throughput if entered, else fall back to totalOut
  const denom = throughput > 0 ? throughput : totalOut;
 
  if (denom === 0) {
    showEmpty('—');
    return;
  }
 
  // ratios as fraction of throughput
  const ratios = {
    local: totals.local / denom,
    close: totals.close / denom,
    far:   totals.far   / denom,
    void:  totals.void  / denom,
  };
 
  // unaccounted = throughput gap (money we know came in but has no outflow row)
  const unaccounted = throughput > 0 ? Math.max(0, throughput - totalOut) / throughput : 0;
  const voidTotal   = ratios.void + unaccounted;
 
  // depth_2 = known outflows ÷ throughput
  const depth2 = 1 - voidTotal;
 
  // eddy_2 = local + (close × 0.5) as fraction of throughput
  const e2 = ratios.local + ratios.close * 0.5;
 
  // ── depth_2 display ──
  document.getElementById('ss-val').textContent    = depth2.toFixed(3);
  document.getElementById('ss-bar').style.width    = (depth2 * 100).toFixed(1) + '%';
  document.getElementById('ss-label').textContent  = depth2Label(depth2);
  document.getElementById('depth1-val').textContent = depth2.toFixed(3);
 
  // ── eddy_2 display ──
  document.getElementById('e2-val').textContent    = e2.toFixed(3);
  document.getElementById('e2-bar').style.width    = (e2 * 100).toFixed(1) + '%';
  document.getElementById('e2-label').textContent  = e2Label(e2);
  const e2bar = document.getElementById('e2-bar');
  if      (e2 >= 0.8) e2bar.style.background = 'var(--green)';
  else if (e2 >= 0.6) e2bar.style.background = 'var(--amber)';
  else if (e2 >= 0.4) e2bar.style.background = '#d0a030';
  else                e2bar.style.background = 'var(--red)';
 
  // ── math mode arrays ──
  document.getElementById('e2-local').textContent = ratios.local.toFixed(3);
  document.getElementById('e2-close').textContent = ratios.close.toFixed(3);
  document.getElementById('e2-far').textContent   = ratios.far.toFixed(3);
  document.getElementById('e2-void').textContent  = voidTotal.toFixed(3);
  document.getElementById('e2-depth').textContent = depth2.toFixed(3);
 
  // ── zone vector bar ──
  const barRatios = { local: ratios.local, close: ratios.close, far: ratios.far, void: voidTotal };
  ['local','close','far','void'].forEach(z => {
    const el  = document.getElementById(`vb-${z}`);
    const pct = barRatios[z] * 100;
    el.style.width = pct.toFixed(1) + '%';
    el.textContent = pct > 8 ? pct.toFixed(0) + '%' : '';
  });
 
  // ── legend ──
  ['local','close','far'].forEach(z => {
    document.getElementById(`l-${z}-pct`).textContent = (ratios[z] * 100).toFixed(1) + '%';
    document.getElementById(`l-${z}-amt`).textContent = fmt$(totals[z]);
  });
  const voidAmt = totals.void + (throughput > 0 ? Math.max(0, throughput - totalOut) : 0);
  document.getElementById('l-void-pct').textContent = (voidTotal * 100).toFixed(1) + '%';
  document.getElementById('l-void-amt').textContent = fmt$(voidAmt);
 
  document.getElementById('l-total').textContent = throughput > 0
    ? fmt$(throughput) + ' / mo'
    : fmt$(totalOut)   + ' / mo (outflows only — enter inflows for full picture)';
 
  if (exportOpen) buildExport();
}
 
function showEmpty(throughput='—') {
  document.getElementById('ss-val').textContent = '—';
  document.getElementById('e2-val').textContent = '—';
  document.getElementById('ss-bar').style.width = '0%';
  document.getElementById('e2-bar').style.width = '0%';
  document.getElementById('ss-label').textContent = 'fraction of outflows with known destination';
  document.getElementById('e2-label').textContent = 'local + (close × 0.5)';
  document.getElementById('depth1-val').textContent = '—';
  ['local','close','far'].forEach(z => document.getElementById(`vb-${z}`).style.width='0%');
  document.getElementById('vb-void').style.width='100%';
  document.getElementById('vb-void').textContent='no data';
  ['local','close','far','void'].forEach(z => {
    document.getElementById(`l-${z}-pct`).textContent='—';
    document.getElementById(`l-${z}-amt`).textContent='';
  });
  document.getElementById('l-total').textContent = throughput;
  ['e2-local','e2-close','e2-far','e2-void','e2-depth'].forEach(id => {
    document.getElementById(id).textContent='—';
  });
}
 
// ── Labels ─────────────────────────────────────────────────────────────────
function depth2Label(v) {
  if (v>=0.9) return 'Nearly complete — most throughput accounted for';
  if (v>=0.6) return 'Good coverage';
  if (v>=0.3) return 'Partial — significant throughput unaccounted for';
  return 'Low coverage — enter more outflows or inflow data';
}
function e2Label(v) {
  if (v>=0.8) return 'Exceptional local circulation';
  if (v>=0.6) return 'Strong local circulation';
  if (v>=0.4) return 'Moderate local circulation';
  if (v>=0.2) return 'Low local circulation';
  return 'Very low local circulation';
}
 
function escHtml(s) {
  return String(s).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;');
}
 
// ── Theme ───────────────────────────────────────────────────────────────────
function toggleTheme() {
  const light = document.body.classList.toggle('light');
  document.getElementById('theme-btn').textContent = light ? '● dark' : '☀ light';
}
 
// ── Init ───────────────────────────────────────────────────────────────────
renderZipLists();
addOutRow(); addOutRow(); addOutRow();
addInRow();
</script>
